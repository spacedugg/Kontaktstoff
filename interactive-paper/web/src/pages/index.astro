---
import Layout from '../layouts/Layout.astro';
import Journey from '../components/Journey.astro';
import UseCases from '../components/UseCases.astro';
import CampaignDashboard from '../components/CampaignDashboard.astro';
---
<Layout title="Impulse — Marketing zum Antippen" pageClass="launch-v5">
  <main id="main">
    <section class="launch-hero" id="produkt" aria-labelledby="hero-title"><div class="launch-shell hero-grid">
      <div class="hero-message"><p class="launch-label">Kontaktstoff Impulse <span>Direct Mail. Upgraded.</span></p><h1 id="hero-title">Marketing.<br /><em>Zum Antippen.</em></h1><p class="hero-definition"><strong>Die NFC-Briefkarte für Ihren Kunden-Outreach.</strong> Individuell gestaltet. Mit einem Tap zum digitalen Erlebnis — und weiter zu Kauf, Anfrage oder Termin.</p><div class="launch-actions"><button class="launch-button" type="button" data-enquiry>Kampagne starten <span aria-hidden="true">↗</span></button><a class="launch-link" href="#ablauf">Impulse kennenlernen <span aria-hidden="true">↓</span></a></div><p class="hero-audience">Für B2B und B2C. Für Marken, die mehr aus ihrem Mailing machen.</p></div>
      <figure class="hero-product-v5"><img src="/images/v5/product-hero.webp" width="1536" height="1024" fetchpriority="high" alt="Das Produkt Kontaktstoff Impulse: drei gestaltete NFC-Briefkarten, vorne in Neongelb, mit einem mittigen Handy-Feld und der Anweisung Hold your unlocked phone here." /><figcaption>Ihre Marke. Ihr Design. NFC direkt in der Briefkarte.</figcaption></figure>
    </div></section>
    <section class="launch-proof" aria-label="Illustrative Wirkungszahlen"><div class="launch-shell"><div class="proof-grid"><div><strong>78<span>%</span></strong><p>Interaktion</p></div><div><strong>65<span>%</span></strong><p>Website-Besuche</p></div><div><strong>24<span>%</span></strong><p>Conversion</p></div></div><p class="proof-note">Beispielwerte aus dem Referenz-Dashboard von <a href="https://interactivepaper.com/tap" target="_blank" rel="noopener noreferrer">Interactive Paper TAP</a>. Keine erhobenen Kontaktstoff-Ergebnisse.</p></div></section>
    <Journey />
    <section class="experience-spotlight" aria-labelledby="experience-title"><div class="launch-shell spotlight-grid"><div><p class="launch-label">Das Erlebnis-Upgrade für Ihr Marketing</p><h2 id="experience-title">Aus Aufmerksamkeit<br />wird <em>Interaktion.</em></h2><p>Ein Produkt in 3D entdecken. Eine Leistung erleben. Ein Angebot öffnen. Impulse bringt Ihre Botschaft aufs Smartphone — mit einem direkten Weg zum nächsten Schritt.</p><a class="launch-link" href="#anwendungen">Möglichkeiten entdecken <span aria-hidden="true">↓</span></a><div class="benefit-chips"><span>3D & AR</span><span>Video & Story</span><span>Shop & Termin</span></div></div><img src="/images/v5/experience.webp" width="1536" height="1024" loading="lazy" alt="Eine Impulse-Briefkarte und ein iPhone mit digitaler 3D-Produktansicht sowie dem Button Zum Produkt" /></div></section>
    <section class="tracking-section" id="dashboard" aria-labelledby="tracking-title"><div class="launch-shell"><div class="launch-heading"><p class="launch-label">Das Impulse Kampagnen-Dashboard</p><h2 id="tracking-title">Ihr Mailing wirkt.<br /><span>Sie sehen, wie.</span></h2><p>Vom geöffneten Erlebnis bis zur Conversion: Verfolgen Sie, was Ihre Kampagne auslöst — und optimieren Sie Ihren nächsten Outreach.</p></div><CampaignDashboard /><div class="tracking-bottom"><p>Als Tap zählt der geöffnete Kampagnen-Link. Käufe und Termine werden über die angebundene Zielseite erfasst.</p><a class="launch-button launch-button--white" href="/auswertung/">Dashboard ansehen <span aria-hidden="true">↗</span></a></div></div></section>
    <UseCases />
    <section class="launch-finish" id="kampagne"><div class="launch-shell"><p class="launch-label">Print. Erlebnis. Auswertung.</p><h2>Geben Sie Ihrem Marketing<br />den nächsten <em>Impuls.</em></h2><p>Ihre Zielgruppe. Ihre Botschaft. Eine Kampagne, die beides verbindet.<br />Wir gestalten Karte und digitales Erlebnis gemeinsam mit Ihnen.</p><button class="launch-button launch-button--ink" type="button" data-enquiry>Ihre Kampagne besprechen <span aria-hidden="true">↗</span></button><p class="compatibility-note">Kompatibles NFC-Smartphone und Internet erforderlich. Für AR gegebenenfalls Kamerafreigabe.</p></div></section>
  </main>
</Layout>

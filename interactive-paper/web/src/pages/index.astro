---
import {assetUrl} from '../data/assets';
import Layout from '../layouts/Layout.astro';
import Journey from '../components/Journey.astro';
import UseCases from '../components/UseCases.astro';
import CampaignDashboard from '../components/CampaignDashboard.astro';
import FAQ from '../components/FAQ.astro';
---
<Layout title="Impulse — Marketing zum Antippen" pageClass="launch-v6 launch-v7 launch-v8 launch-v9 launch-v10">
<main id="main">
 <section class="launch-hero" id="produkt" aria-labelledby="hero-title"><div class="launch-shell hero-grid">
  <div class="hero-message"><h1 id="hero-title">Marketing.<br />Zum Antippen.</h1><p class="hero-definition">Impulse macht Ihre Briefkarte interaktiv. In Ihrem Design. Mit NFC direkt zum digitalen Erlebnis — und weiter zu Kauf oder Gespräch.</p><button class="launch-button" type="button" data-enquiry>Kampagne starten <span aria-hidden="true">↗</span></button></div>
  <img class="hero-campaigns" src={assetUrl('hero')} width="1536" height="1024" fetchpriority="high" alt="Drei individuell bedruckte Briefkarten für Hydration, Privatsphäre und Essen, jeweils mit kleinem quadratischem Tap-Feld" />
 </div></section>
 <section class="launch-proof" aria-label="Beispielquoten"><div class="launch-shell"><p class="proof-kind">Beispielwerte</p><div class="proof-grid"><div><strong>77<span>%</span></strong><p>Interaktion</p></div><div><strong>64<span>%</span></strong><p>Website-Besuche</p></div><div><strong>23<span>%</span></strong><p>Conversion</p></div></div></div></section>
 <Journey />
 <section class="experience-spotlight"><div class="launch-shell spotlight-grid"><div><h2>Das Mailing<br />mit Wow-Moment.</h2><p>Ihr Produkt wird zum Erlebnis: auf dem Smartphone entdecken, in 3D erleben und direkt zum Angebot gelangen.</p></div><img src={assetUrl('revolut')} width="1536" height="1024" loading="lazy" alt="Revolut-Kampagnenkonzept: eine Bankkarte als räumliches Erlebnis auf dem Smartphone neben der NFC-Briefkarte" /></div></section>
 <section class="nfc-section" id="technologie"><div class="launch-shell nfc-grid"><img src={assetUrl('paper')} width="1536" height="1024" loading="lazy" alt="Eine NordVPN-Briefkarte wird an der Kante gehalten: nahezu exakt seitliche Ansicht des gleichmäßig flachen Papiers" /><div><p class="launch-label">Unsichtbar integriert.</p><h2>Flaches Papier.<br />Tiefe Wirkung.</h2><p>Unser Designanspruch: NFC im Inneren, eine ebene Fläche außen. Keine aufgeklebte Technik, die Ihrem Motiv die Bühne nimmt.</p><p>Das Tap-Feld fügt sich dezent in die Gestaltung ein. Ihre Marke bleibt der Hauptdarsteller.</p><a class="launch-link" href="/technologie/">Technologie entdecken ↗</a></div></div></section>
 <section class="material-features"><div class="launch-shell material-grid"><article><img src={assetUrl('finish')} width="1536" height="1024" loading="lazy" alt="HOLY-Nahaufnahme mit scharfer Druckkante, grünem Blatt und Wassertropfen"/><div><p class="launch-label">Qualität, die man in die Hand nimmt.</p><h2>Gestochen<br />scharf.</h2><p>Eine feine Oberfläche. Klare Farben. Ein stimmiger Gesamteindruck. Papier und Finish stimmen wir auf Ihre Marke ab — mit einem Muster vor der Freigabe.</p></div></article><article><img src={assetUrl('116media')} width="1536" height="1024" loading="lazy" alt="116-Media-Kampagnenkarte und ein räumliches Technik-Erlebnis auf dem Smartphone"/><div><p class="launch-label">Sehen. Spüren. Öffnen.</p><h2>Ein Tap.<br />Pures Erlebnis.</h2><p>Die Einladung erscheint auf dem Smartphone. Je nach Gerät und Einstellung begleitet eine kurze haptische Rückmeldung den Kontakt. Ein Antippen öffnet das Erlebnis.</p></div></article></div></section>
 <section class="mail-comparison" id="vergleich"><div class="launch-shell"><div class="launch-heading"><p class="launch-label">Postwerbung. Weitergedacht.</p><h2>Interaktive<br />Postwerbung.</h2></div><div class="comparison-grid"><article class="compare-qr"><a class="comparison-qr" href="/produkt/" aria-label="Produktseite öffnen"><img src="/images/v9/qr-code.svg" width="180" height="180" alt="QR-Code zur Impulse-Produktseite" loading="lazy" /></a><span class="compare-label">Mailing mit QR-Code</span><strong>4,5<span>%</span></strong><p>Scanrate im Vergleichsszenario</p><div class="compare-track"><span style="width:12.857%"></span></div><ol><li>Kamera öffnen</li><li>Code ausrichten und scannen</li><li>Link öffnen</li></ol></article><article class="compare-nfc"><img class="comparison-experience" src={assetUrl('truenature')} width="1536" height="1024" loading="lazy" alt="Freigestellte True-Nature-Karte mit grünem Produkterlebnis auf dem Smartphone" /><span class="compare-label">Mailing mit NFC</span><strong>35<span>%</span></strong><p>Tap-Rate im Vergleichsszenario</p><div class="compare-track"><span style="width:100%"></span></div><ol><li>Handy ans Tap-Feld halten</li><li>Link öffnen und erleben</li></ol></article></div><div class="comparison-bottom"><button type="button" class="launch-link" data-open-comparison>Zahlen einordnen <span aria-hidden="true">↗</span></button></div></div></section>
 <section class="tracking-section" id="dashboard"><div class="launch-shell"><div class="launch-heading"><p class="launch-label">Ihr Impulse Portal</p><h2>Eine Kampagne.<br /><span>Alles im Blick.</span></h2><p>Kontakte, Kartendesign, Versand und Erlebnis an einem Ort. Verfolgen Sie anschließend, was aus dem Tap wird.</p></div><CampaignDashboard /></div></section>
 <UseCases />
 <FAQ limit={6} />
 <section class="launch-finish" id="kampagne"><div class="launch-shell"><h2>Geben Sie Ihrem Marketing<br />die nächsten <em>Impulse.</em></h2><p>Ihre Zielgruppe. Ihre Botschaft. Ihre Karte.<br />Wir bringen das passende Erlebnis dazu.</p><button class="launch-button launch-button--ink" type="button" data-enquiry>Kampagne starten <span aria-hidden="true">↗</span></button></div></section>
</main>
<dialog class="numbers-dialog" data-comparison-dialog aria-labelledby="comparison-title"><button class="dialog-close" type="button" data-close-comparison aria-label="Schließen">×</button><h2 id="comparison-title">Der Vergleich im Kontext</h2><p>4,5 % QR-Scanrate und 35 % NFC-Tap-Rate bilden das vorgegebene Vergleichsszenario ab. Die exakte Kombination ist hier nicht unabhängig belegt und kein allgemeiner Benchmark.</p><p>Interactive Paper nennt für Printwerbung eigene Anbieterangaben von 2–3 % für QR und 35–65 % für NFC. Vergleichbare Zielgruppen, Messzeiträume und Bezugsgrößen sind entscheidend.</p><a class="launch-link" href="https://interactivepaper.com/touch-for-print-advertising" target="_blank" rel="noopener noreferrer">Anbieterquelle öffnen ↗</a></dialog>
</Layout>
<script>
for(const key of ['comparison']){const dialog=document.querySelector<HTMLDialogElement>(`[data-${key}-dialog]`);document.querySelector(`[data-open-${key}]`)?.addEventListener('click',()=>dialog?.showModal());document.querySelector(`[data-close-${key}]`)?.addEventListener('click',()=>dialog?.close());}
</script>

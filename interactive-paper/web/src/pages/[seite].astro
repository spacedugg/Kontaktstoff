---
import Layout from '../layouts/Layout.astro';
import {pages} from '../data/pages';
export function getStaticPaths(){return pages.map(page=>({params:{seite:page.slug},props:{page}}));}
const {page}=Astro.props;
const legal=['impressum','datenschutz','agb'].includes(page.slug);
---
<Layout title={page.title} description={page.lead} pageClass="launch-v6 editorial-site"><main id="main"><header class:list={['editorial-hero',{'editorial-hero--legal':legal}]}><div class="launch-shell"><nav class="crumbs" aria-label="Brotkrumen"><a href="/">Impulse</a><span aria-hidden="true">/</span><span aria-current="page">{page.label}</span></nav><div class:list={['editorial-hero-grid',{'editorial-hero-grid--text':!page.image}]}><div><p class="launch-label">{page.label}</p><h1>{page.title}</h1><p class="editorial-lead">{page.lead}</p>{!legal&&page.slug!=='karriere'&&<button class="launch-button" type="button" data-enquiry>{page.slug==='kontakt'?'Briefing vorbereiten':'Kampagne besprechen'} ↗</button>}{page.slug==='karriere'&&<span class="vacancy-badge">0 offene Stellen</span>}</div>{page.image&&<img src={'/images/v7/'+page.image+'.webp'} width="1536" height="1024" alt={page.label+' – visuelles Konzept für Kontaktstoff Impulse'}/>}</div></div></header><div class="launch-shell editorial-body"><aside class="article-index"><p>Auf dieser Seite</p>{page.sections.map((s,i)=><a href={'#abschnitt-'+(i+1)}>{s.heading}</a>)}</aside><article class="reading-column">{page.sections.map((s,i)=><section id={'abschnitt-'+(i+1)}><h2>{s.heading}</h2>{s.paragraphs.map(text=><p>{text}</p>)}</section>)}{page.slug==='datenschutz'&&<button class="launch-button" type="button" data-cookie-settings>Cookie-Einstellungen öffnen</button>}{!legal&&<div class="article-next"><h2>{page.slug==='karriere'?'Mehr über die Idee hinter Impulse.':'Gemeinsam den nächsten Schritt planen.'}</h2><a class="launch-link" href={page.slug==='karriere'?'/ueber-uns/':'/kontakt/'}>{page.slug==='karriere'?'Über Impulse':'Zum Kontakt'} ↗</a></div>}</article></div></main></Layout>

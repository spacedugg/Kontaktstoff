---
import Layout from '../layouts/Layout.astro';
import {pages} from '../data/pages';
export function getStaticPaths(){return pages.map(page=>({params:{seite:page.slug},props:{page}}));}
const {page}=Astro.props;
const legal=['impressum','datenschutz','agb'].includes(page.slug);
const imagePath=page.image?'/images/'+(['paper','finish'].includes(page.image)?'v8/':'v7/')+page.image+'.webp':null;
---
<Layout title={page.title} description={page.lead} pageClass="launch-v6 brand-site"><main id="main"><header class:list={['brand-hero',{'brand-hero--legal':legal}]}><div class="launch-shell"><nav class="crumbs" aria-label="Brotkrumen"><a href="/">Impulse</a><span aria-hidden="true">/</span><span aria-current="page">{page.label}</span></nav><p class="launch-label">{page.label}</p><h1>{page.title}</h1><p class="brand-lead">{page.lead}</p>{!legal&&page.slug!=='karriere'&&<button class="launch-button" type="button" data-enquiry>{page.slug==='kontakt'?'Briefing vorbereiten':'Kampagne besprechen'} ↗</button>}{page.slug==='karriere'&&<span class="vacancy-badge">0 offene Stellen</span>}{imagePath&&<div class="brand-hero-art"><img src={imagePath} width="1536" height="1024" alt={page.label+' – visuelles Konzept für Kontaktstoff Impulse'}/></div>}</div></header><div class:list={['launch-shell brand-content',{'brand-content--legal':legal}]}><div class="brand-feature-grid">{page.sections.map((s,i)=><section class="brand-feature" id={'abschnitt-'+(i+1)}>{!legal&&<span class="brand-feature-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>}<h2>{s.heading}</h2>{s.paragraphs.map(text=><p>{text}</p>)}</section>)}</div>{page.slug==='datenschutz'&&<button class="launch-button" type="button" data-cookie-settings>Cookie-Einstellungen öffnen</button>}</div>{!legal&&<section class="brand-page-cta launch-shell"><p class="launch-label">Impulse von Kontaktstoff</p><h2>{page.slug==='karriere'?'Lernen Sie die Idee hinter Impulse kennen.':'Ihre Idee. Gemeinsam weitergedacht.'}</h2><p>{page.slug==='karriere'?'Was uns antreibt und was wir mit interaktiver Post vorhaben.':'Von der Gestaltung bis zum digitalen Erlebnis: Wir unterstützen Sie bei Ihrer Kampagne.'}</p>{page.slug==='karriere'?<a class="launch-button" href="/ueber-uns/">Über Impulse ↗</a>:<button class="launch-button" type="button" data-enquiry>Kampagne starten ↗</button>}</section>}</main></Layout>

---
import Layout from '../layouts/Layout.astro';
import comparisons from '../data/comparisons.json';
---
<Layout title="NFC-Mailings und Alternativen im Vergleich" pageClass="launch-v6 editorial-site centered-editorial"><main id="main"><header class="editorial-hero"><div class="launch-shell"><p class="launch-label">Alternativen & Vergleiche</p><h1>Der passende Weg<br />zu Ihrem nächsten Kunden.</h1><p class="editorial-lead">Anbieter, Technik und Kommunikationsweg: Drei Vergleiche helfen, die richtige Entscheidung für Ihre Kampagne zu treffen.</p></div></header><section class="launch-shell journal-grid comparison-directory">{comparisons.map(c=><article class="journal-card"><a href={'/vergleich/'+c.slug+'/'}><img src={'/images/v7/'+c.image+'.webp'} width="1536" height="1024" loading="lazy" alt={c.label}/><div><p class="journal-meta">Vergleich</p><h2>{c.label}</h2><p>{c.lead}</p><span class="launch-link">Vergleich öffnen ↗</span></div></a></article>)}</section></main></Layout>

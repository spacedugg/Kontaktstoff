---
import Layout from '../../layouts/Layout.astro';
import comparisons from '../../data/comparisons.json';
export function getStaticPaths(){return comparisons.map(page=>({params:{slug:page.slug},props:{page}}));}
const {page}=Astro.props;
---
<Layout title={page.label+' im Vergleich'} description={page.lead} pageClass="launch-v6 editorial-site centered-editorial"><main id="main"><header class="editorial-hero"><div class="launch-shell"><nav class="crumbs" aria-label="Brotkrumen"><a href="/">Impulse</a><span>/</span><a href="/alternativen/">Vergleichen</a><span>/</span><span aria-current="page">{page.label}</span></nav><div class="editorial-hero-grid"><div><p class="launch-label">{page.label}</p><h1>{page.title}</h1><p class="editorial-lead">{page.lead}</p></div><img src={'/images/v7/'+page.image+'.webp'} width="1536" height="1024" alt={page.label+' – Karte und digitales Erlebnis'}/></div></div></header><section class="launch-shell comparison-detail"><h2>Die Unterschiede im Überblick.</h2><div class="comparison-table-wrap"><table><caption>{page.label}: Merkmale der beiden Ansätze</caption><thead><tr><th scope="col">Kriterium</th><th scope="col">{page.leftTitle}</th><th scope="col">{page.rightTitle}</th></tr></thead><tbody>{page.rows.map(r=><tr><th scope="row">{r.topic}</th><td>{r.left}</td><td>{r.right}</td></tr>)}</tbody></table></div><div class="comparison-explanation">{page.sections.map(s=><section><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}</div>{page.sources.length>0&&<div class="comparison-sources"><h2>Quellen</h2>{page.sources.map(s=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a>)}</div>}</section><section class="compact-cta launch-shell"><h2>Welcher Weg passt<br />zu Ihrer Kampagne?</h2><a class="launch-button" href="/kontakt/">Kampagne besprechen ↗</a></section></main></Layout>

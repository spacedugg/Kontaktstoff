---
import Layout from '../../layouts/Layout.astro';
import articles from '../../data/articles.json';
const categories=['Alle',...new Set(articles.map(a=>a.category))];
---
<Layout title="Journal — Ideen für interaktive Post" description="Praxiswissen zu NFC-Mailings, Gestaltung, AR-Erlebnissen und messbaren Kampagnen." pageClass="launch-v6 editorial-site centered-editorial"><main id="main"><header class="editorial-hero journal-intro"><div class="launch-shell"><p class="launch-label">Das Impulse Journal</p><h1>Gute Post beginnt<br />mit einer guten Idee.</h1><p class="editorial-lead">Gedanken, Anleitungen und Vergleiche für Kampagnen, die vom Briefkasten weiterführen.</p></div></header><section class="launch-shell journal-content"><div class="journal-controls"><div class="journal-filters" role="group" aria-label="Artikelkategorie">{categories.map((c,i)=><button type="button" data-blog-category={c} aria-pressed={String(i===0)}>{c}</button>)}</div><label class="journal-search"><span>Journal durchsuchen</span><input type="search" data-blog-search placeholder="NFC, Design, Kampagne …" /></label></div><p class="journal-count" role="status" data-blog-count>{articles.length} Artikel</p><div class="journal-grid">{articles.map(a=><article class="journal-card" data-blog-card data-category={a.category} data-search={[a.title,a.lead,a.category].join(' ').toLocaleLowerCase('de')}><a href={'/blog/'+a.slug+'/'}><img src={'/images/v7/'+a.image+'.webp'} width="1536" height="1024" loading="lazy" alt={a.title+' – Kampagnenvisualisierung'} /><div><p class="journal-meta">{a.category}<span>{a.minutes} Min. Lesezeit</span></p><h2>{a.title}</h2><p>{a.lead}</p><span class="launch-link">Beitrag lesen ↗</span></div></a></article>)}</div><p class="journal-empty" data-blog-empty hidden>Kein passender Artikel gefunden. Probieren Sie einen anderen Suchbegriff oder „Alle“.</p></section></main></Layout>
<script>import '../../scripts/blog';</script>

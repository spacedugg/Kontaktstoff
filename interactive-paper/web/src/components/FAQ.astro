---
import questions from '../data/faq.json';
const {limit=0}=Astro.props;
const selected=limit?[questions[0],questions[1],questions[4],questions[7],questions[9],questions[11]].slice(0,limit):questions;
---
<section class="faq-section-v7" id="fragen"><div class="launch-shell"><div class="launch-heading"><p class="launch-label">Gut zu wissen</p><h2>Ihre Fragen.<br />Klare Antworten.</h2></div><div class="faq-pills">{selected.map(item=><details class="faq-pill"><summary><span>{item.question}</span><span class="faq-toggle" aria-hidden="true"></span></summary><div class="faq-answer"><p>{item.answer}</p></div></details>)}</div>{limit>0&&<div class="faq-more"><a class="launch-link" href="/faq/">Alle Fragen und Antworten ↗</a></div>}</div></section>

---
import questions from '../data/faq.json';
const {limit=0}=Astro.props;
const selected=limit?[questions[0],questions[1],questions[4],questions[7],questions[9],questions[11]].slice(0,limit):questions;
---
<section class="faq-section-v7" id="fragen"><div class="launch-shell"><div class="launch-heading"><p class="launch-label">Gut zu wissen</p><h2>Ihre Fragen.<br />Klare Antworten.</h2></div><div class="faq-open-grid">{selected.map(item=><article><span>{item.category}</span><h3>{item.question}</h3><p>{item.answer}</p></article>)}</div>{limit>0&&<a class="launch-link faq-more" href="/faq/">Alle Fragen und Antworten ↗</a>}</div></section>

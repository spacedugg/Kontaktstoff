---
const {instance='portal'}=Astro.props;
const tabs=[['overview','Kampagne','▦'],['contacts','Kontakte','◎'],['design','Kartendesign','▧'],['shipping','Versand','↗'],['experience','Erlebnis','◇'],['tracking','Tracking','↗']];
const bars=[28,41,56,72,64,67,50];
---
<div class="impulse-portal" data-portal>
 <div class="portal-top"><strong>Impulse<span>Workspace</span></strong><span class="portal-demo">Demo</span><span class="portal-avatar" aria-label="Ihr Team">IT</span></div>
 <div class="portal-layout"><nav class="portal-sidebar" aria-label="Kampagnenansichten"><p>Ihr Workspace</p><div role="tablist" aria-label="Portalbereiche" aria-orientation="vertical">{tabs.map(([key,label,icon],i)=><button type="button" role="tab" id={instance+'-tab-'+key} aria-controls={instance+'-panel-'+key} aria-selected={String(i===0)} tabindex={i===0?0:-1} data-portal-tab={key}><span aria-hidden="true">{icon}</span>{label}</button>)}</div><div class="portal-team"><span>HY</span><div>Hydration Launch<small>Kampagne 01</small></div></div></nav>
 <div class="portal-workspace">
 <section role="tabpanel" id={instance+'-panel-overview'} aria-labelledby={instance+'-tab-overview'} data-portal-panel="overview" tabindex="0"><div class="portal-heading"><div><p>Ihre aktuelle Kampagne</p><h3>Ein frischer Impuls.</h3></div><span class="portal-status">In Umsetzung</span></div><div class="portal-overview"><img src="/images/v7/arrival.webp" width="1536" height="1024" loading="lazy" alt="Eine einzelne HOLY-Briefkarte für die Hydration-Kampagne" /><div><h4>Hydration Launch</h4><dl><div><dt>Zielgruppe</dt><dd>Bestandskunden</dd></div><div><dt>Format</dt><dd>NFC-Briefkarte</dd></div><div><dt>Kampagnenziel</dt><dd>Produkt entdecken</dd></div></dl><button type="button" data-portal-goto="design" class="portal-action">Design ansehen ↗</button></div></div><div class="portal-kpis"><div><span>Kontakte</span><strong>1.200</strong></div><div><span>Versendet</span><strong>1.080</strong></div><div><span>Erlebnis-Aufrufe</span><strong>378</strong></div></div><ol class="portal-timeline"><li><span>✓</span>Design freigegeben</li><li><span>✓</span>NFC-Ziel verknüpft</li><li><span>↗</span>Versand läuft</li></ol></section>
 <section role="tabpanel" id={instance+'-panel-contacts'} aria-labelledby={instance+'-tab-contacts'} data-portal-panel="contacts" tabindex="0" hidden><div class="portal-heading"><div><p>Empfänger & Segmente</p><h3>Die richtigen Kontakte.</h3></div><strong>1.200</strong></div><div class="portal-table-wrap"><table><caption>Zielgruppen der Kampagne</caption><thead><tr><th>Segment</th><th>Kontakte</th><th>Status</th></tr></thead><tbody><tr><td>Bestandskunden</td><td>800</td><td><span class="portal-status">Bereit</span></td></tr><tr><td>Interessenten</td><td>280</td><td><span class="portal-status">Bereit</span></td></tr><tr><td>Neue Kontakte</td><td>120</td><td>Adressprüfung</td></tr></tbody></table></div><div class="portal-note"><h4>Eine Kampagne. Ein gemeinsames Erlebnis.</h4><p>Empfängergruppen organisieren und den Versand vorbereiten. Die NFC-Karten dieser Kampagne öffnen denselben Einstieg.</p></div></section>
 <section role="tabpanel" id={instance+'-panel-design'} aria-labelledby={instance+'-tab-design'} data-portal-panel="design" tabindex="0" hidden><div class="portal-heading"><div><p>Karte & Gestaltung</p><h3>Ihre Marke auf Papier.</h3></div><span class="portal-status">Freigegeben</span></div><div class="portal-design"><img data-portal-artwork src="/images/v7/holy.webp" width="1536" height="1024" loading="lazy" alt="Kampagnenidee Hydration mit individuell bedruckter NFC-Karte" /><div><h4>Designrichtungen entdecken</h4><p>Farben, Bilder und Botschaft richten sich nach Ihrer Kampagne.</p><div class="portal-design-options" role="group" aria-label="Designrichtung"><button type="button" aria-pressed="true" data-portal-design="holy">Hydration</button><button type="button" aria-pressed="false" data-portal-design="nordvpn">Service</button><button type="button" aria-pressed="false" data-portal-design="prepmymeal">Food</button></div></div></div></section>
 <section role="tabpanel" id={instance+'-panel-shipping'} aria-labelledby={instance+'-tab-shipping'} data-portal-panel="shipping" tabindex="0" hidden><div class="portal-heading"><div><p>Produktion & Versand</p><h3>Von hier zu Ihren Kunden.</h3></div></div><div class="shipping-summary"><strong>1.080 <span>von 1.200 Karten versendet</span></strong><progress value="1080" max="1200" aria-label="Versandfortschritt">90 %</progress></div><ol class="shipping-steps"><li><span>01</span><div><h4>Druck abgeschlossen</h4><p>1.200 Karten produziert</p></div><b>✓</b></li><li><span>02</span><div><h4>NFC verknüpft</h4><p>Kampagnen-Link hinterlegt und geprüft</p></div><b>✓</b></li><li><span>03</span><div><h4>Versand läuft</h4><p>120 Adressen werden noch geprüft</p></div><b>↗</b></li></ol></section>
 <section role="tabpanel" id={instance+'-panel-experience'} aria-labelledby={instance+'-tab-experience'} data-portal-panel="experience" tabindex="0" hidden><div class="portal-heading"><div><p>Das Ziel hinter dem Tap</p><h3>Ihr Erlebnis. Ihr nächster Schritt.</h3></div></div><div class="portal-design"><img src="/images/v7/experience.webp" width="1536" height="1024" loading="lazy" alt="Räumliches Hydration-Produkterlebnis"/><div><h4>Hydration in 3D</h4><p>Das Mailing öffnet das Produkterlebnis. Der Call-to-Action führt zur passenden Shopseite.</p><dl><div><dt>Einstieg</dt><dd>3D-Produktexperience</dd></div><div><dt>Button</dt><dd>Sorten entdecken</dd></div><div><dt>Ziel</dt><dd>Ihre Produktseite</dd></div></dl></div></div></section>
 <section role="tabpanel" id={instance+'-panel-tracking'} aria-labelledby={instance+'-tab-tracking'} data-portal-panel="tracking" tabindex="0" hidden><div class="portal-heading"><div><p>Wirkung Ihrer Kampagne</p><h3>Was nach dem Tap passiert.</h3></div><span>7 Tage</span></div><div class="portal-kpis"><div><span>Erlebnis-Aufrufe</span><strong>378</strong></div><div><span>Klicks zum Shop</span><strong>241</strong></div><div><span>Zielaktionen</span><strong>56</strong></div></div><div class="portal-chart"><h4>Erlebnis-Aufrufe pro Tag</h4><div class="portal-bars" role="img" aria-label="Beispielverlauf: Montag 28, Dienstag 41, Mittwoch 56, Donnerstag 72, Freitag 64, Samstag 67, Sonntag 50 Aufrufe">{bars.map((n,i)=><div><span>{n}</span><div><i style={'height:'+n/80*100+'%'}></i></div><span>{['Mo','Di','Mi','Do','Fr','Sa','So'][i]}</span></div>)}</div></div><p class="portal-caption">Gezählt wird das geöffnete Erlebnis. Zielaktionen benötigen eine angebundene Messung auf der Zielseite.</p></section>
 </div></div>
</div>
<script>
import '../scripts/portal';
</script>

---
const steps=[
 {name:'Auffallen.',image:'product-hero',alt:'Individuell gestaltete Impulse-Briefkarte mit mittigem Handy-Feld',text:'Ihr Mailing kommt an. In Ihrem Design, mit Ihrer Botschaft und einer klaren Einladung zum Antippen.'},
 {name:'Verbinden.',image:'connect',alt:'Ein iPhone wird mit seiner Oberkante nah an das mittige Handy-Feld der Briefkarte gehalten',text:'Entsperrtes Handy ans markierte Feld halten. Link öffnen. Das Erlebnis startet im Browser — ohne Extra-App.'},
 {name:'Aktivieren.',image:'experience',alt:'Das geöffnete Produkterlebnis auf dem iPhone führt über einen Button zur Produktseite',text:'Produkt, Video oder Angebot entdecken. Ein Klick führt zum Shop, zur Anfrage oder zum Termin.'},
];
---
<section class="launch-process" id="ablauf" aria-labelledby="process-title"><div class="launch-shell"><div class="launch-heading"><p class="launch-label">So funktioniert Impulse</p><h2 id="process-title">Eine Karte.<br />Der direkte Weg zu Ihrem Angebot.</h2></div><ol class="launch-steps">{steps.map((step,i)=><li><div class="step-image"><img src={'/images/v5/'+step.image+'.webp'} width="1536" height="1024" loading="lazy" alt={step.alt} /><span aria-hidden="true">0{i+1}</span></div><h3>{step.name}</h3><p>{step.text}</p></li>)}</ol></div></section>

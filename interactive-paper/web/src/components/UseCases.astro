---
const {standalone=false}=Astro.props;
const cases=[
 {tone:'lime',label:'Produkte & E-Commerce',title:'Vom Wow zum Warenkorb.',image:'experience',alt:'iPhone mit digitalem Kopfhörer und einem direkten Produktlink neben einer Impulse-Briefkarte',copy:'Machen Sie Ihren nächsten Produktlaunch erlebbar. Der Shop ist nur einen Klick entfernt.',href:'/beispiel/produkt/',cta:'Produkt-Beispiel öffnen'},
 {tone:'blue',label:'Dienstleistungen & B2B',title:'Leistung zeigen. Termine gewinnen.',image:'appointment',alt:'iPhone mit einem Raumkonzept als Dienstleistungsergebnis und einem Termin-Button neben einer blauen Impulse-Karte',copy:'Zeigen Sie Ihren Wunschkunden das Ergebnis Ihrer Arbeit. Und machen Sie das erste Gespräch einfach.',href:'/beispiel/beratung/',cta:'Termin-Beispiel öffnen'},
 {tone:'coral',label:'Angebote & Bundles',title:'Ihr Angebot. Direkt im Blick.',image:'offer',alt:'iPhone mit einem Smartphone-und-Tarif-Angebot neben einer korallfarbenen Impulse-Briefkarte',copy:'Inszenieren Sie Ihr Paket verständlich — und führen Sie Interessenten direkt auf die passende Angebotsseite.',href:'/beispiel/bundle/',cta:'Angebots-Beispiel öffnen'},
];
---
<section class:list={['launch-applications',{'launch-applications--standalone':standalone}]} id="anwendungen" aria-labelledby="applications-title"><div class="launch-shell"><div class="launch-heading"><p class="launch-label">Ein Medium. Ihr Marketingziel.</p><h2 id="applications-title">Was soll Ihr nächster<br />Outreach auslösen?</h2></div><div class="launch-cases">{cases.map(c=><article data-tone={c.tone}><a class="case-photo" href={c.href} aria-label={c.cta}><img src={'/images/v5/'+c.image+'.webp'} width="1536" height="1024" loading="lazy" alt={c.alt}/></a><div class="case-copy"><p class="launch-label">{c.label}</p><h3>{c.title}</h3><p>{c.copy}</p><a class="launch-link" href={c.href}>{c.cta} <span aria-hidden="true">↗</span></a></div></article>)}</div><p class="launch-small">Konzeptvisualisierungen und Beispiel-Zielseiten. Keine echten Bestellungen oder Buchungen.</p></div></section>

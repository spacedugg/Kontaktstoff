---
import {assetUrl} from '../data/assets';
const {standalone=false}=Astro.props;
const cases=[
 {brand:'HOLY',type:'B2C · Produktlaunch',title:'Geschmack, der neugierig macht.',image:'holy',copy:'Ein Hydration-Launch als räumliches Erlebnis. Von der Mailingkarte zur Lieblingssorte.',goal:'Sorten entdecken'},
 {brand:'NordVPN',type:'B2C · Digitaler Service',title:'Ein Service wird sichtbar.',image:'nordvpn',copy:'Eine digitale Leistung bekommt eine Bühne. Die Karte öffnet die Welt hinter dem Angebot.',goal:'Service kennenlernen'},
 {brand:'PrepMyMeal',type:'B2C · Wiederbestellung',title:'Appetit auf den nächsten Klick.',image:'prepmymeal',copy:'Gerichte entdecken, Favoriten finden, Bestellung starten. Direkt aus dem Briefkasten.',goal:'Gerichte auswählen'},
 {brand:'Revolut',type:'B2C · Produktvorstellung',title:'Eine Karte stellt sich vor.',image:'revolut',copy:'Die Bankkarte als 3D-Objekt entdecken. Anschließend führt der Weg zur Produktinformation.',goal:'Karte entdecken'},
 {brand:'temoa',type:'B2B · Agentur-Outreach',title:'Ihr Listing. Schon weitergedacht.',image:'temoa',copy:'Sieben Bildideen zeigen einer Marke, was aus ihrem Amazon-Auftritt werden könnte. Der nächste Schritt: ein Erstgespräch.',goal:'Erstgespräch buchen'},
 {brand:'True Nature',type:'B2C · Produktentdeckung',title:'Eine neue Routine entdecken.',image:'truenature',copy:'Eine Supplement-Marke präsentiert ihr Produkt räumlich. Die Kampagne führt zur Produktinformation und Auswahl.',goal:'Produkt entdecken'},
 {brand:'Aoste Stikado',type:'B2C · Food & Genuss',title:'Ein kleiner Snack. Ein großer Auftritt.',image:'aoste',copy:'Ein aufmerksamkeitsstarkes Mailing macht das Snack-Sortiment erlebbar — bis zum nächsten Einkauf.',goal:'Sortiment entdecken'},
 {brand:'116 Media',type:'B2B · 3D-Animation',title:'Komplexe Technik. Sofort verständlich.',image:'116media',copy:'Eine 3D-Agentur zeigt schon im Erstkontakt, was ihre Arbeit kann. Aus einer gedruckten Einladung wird eine Produktinszenierung.',goal:'Projekt besprechen'},
];
---
<section class:list={['launch-applications','campaign-ideas',{'launch-applications--standalone':standalone}]} id="anwendungen" aria-labelledby="applications-title"><div class="launch-shell"><div class="launch-heading"><p class="launch-label">Unterschiedliche Marken. Unterschiedliche Möglichkeiten.</p><h2 id="applications-title">Ihr Design setzt<br />den richtigen <em>Impulse.</em></h2><p>Sie bringen Ihr Design mit — oder wir entwickeln es für Sie. Von der ersten Idee bis zur fertigen Kampagnenkarte.</p></div><div class="ideas-grid">{cases.map(c=><article class:list={['idea-card',{'idea-card--wide':c.image==='116media'}]}><div class="idea-image"><img src={assetUrl(c.image)} width="1536" height="1024" loading="lazy" alt={'Freies Kampagnenkonzept für '+c.brand+': individuell gestaltetes Mailing mit kleinem Tap-Feld und digitalem Erlebnis auf einem iPhone'} /></div><div class="idea-copy"><p class="idea-brand">{c.image==='temoa' ? <img class="temoa-brand-logo" src="/images/v7/temoa-logo.svg" width="112" height="40" alt="temoa" loading="lazy" /> : c.brand}<span>{c.type}</span></p><h3>{c.title}</h3><p>{c.copy}</p><span class="idea-goal">Ziel: {c.goal}</span>{c.image==='temoa' && <a class="idea-source" href="/images/v7/temoa-skotti-original.webp" target="_blank" rel="noopener">SKOTTI-Design von temoa ansehen ↗</a>}</div></article>)}</div><p class="concept-note">Freie Kampagnenideen — keine Kundenreferenzen der gezeigten Marken.</p></div></section>

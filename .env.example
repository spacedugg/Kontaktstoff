# Local development starts without these; the SQLite file stays in .data/.
# Vercel requires both values; keep production and preview databases separate.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# PUBLIC_ORIGIN=https://www.kontaktstoff.com
# Optional transactional email (not configured yet):
# RESEND_API_KEY=
# MAIL_FROM=Kontaktstoff <konto@kontaktstoff.com>
# REQUEST_NOTIFICATION_TO=
# Comma-separated team addresses. Operator access also requires verified email.
# OPERATOR_EMAILS=
# Optional local overrides:
# PORT=4177
# SQLITE_PATH=.data/kontaktstoff.sqlite
